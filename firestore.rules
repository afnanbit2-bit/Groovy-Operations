rules_version = '2';
// Groovy Operations — Firestore security rules
// Mirror of what's published in the Firebase Console for the
// `groovy-gatepass` project. Update both in lockstep when changing.
//
// Auth model:
//   Owners   : afnan@groovy.op, ammar@groovy.op
//   Managers : mustafa@groovy.op, arfat@groovy.op
//   All other accounts created by setup are workers/store/viewer.
//
// Most operational tables are open to any signed-in user (matches the
// app's runtime expectations). HRM and payroll are tightened.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userEmail() { return request.auth.token.email; }
    function isOwner() {
      return signedIn() && userEmail() in ['afnan@groovy.op','ammar@groovy.op'];
    }
    function isManager() {
      return signedIn() && userEmail() in ['mustafa@groovy.op','arfat@groovy.op'];
    }
    function isOM() { return isOwner() || isManager(); }
    // Explicit per-person grants (Sept 2026) — deliberately NOT role-wide.
    // Mustafa personally gets fabric delete, loan write and payslip write;
    // Arfat (also role='manager') does NOT. Mirror in js/hrm.js and
    // js/fabric.js (_canManageLoans, _canManagePayslips, _fabCanDelete).
    function isMustafa() {
      return signedIn() && userEmail() == 'mustafa@groovy.op';
    }
    // Pattern Hub (Sept 2026). Owners + Mustafa, by person — never
    // isManager(), which would hand Arfat the registry too. Mirror in
    // js/patterns.js _canManagePatterns() / _PATTERN_HUB_USERS.
    function isPatternAdmin() { return isOwner() || isMustafa(); }
    // Cutting (Uzaib) reads the Pattern Hub and acknowledges a revision
    // notice — nothing else. Mirror in js/patterns.js
    // _PATTERN_CUTTING_USERS.
    function isPatternCutting() { return signedIn() && userEmail() == 'uzaib@groovy.op'; }
    // The Board (Sept 2026). Mirrors BOARD_USERS / BOARD_OWNERS in
    // js/auth.js BY EMAIL; tests/theboard.test.js fails if the two lists
    // ever disagree. isBoardOwner() is NOT the app's `owner` role -- it is
    // who may override a lock, manage access and run the seed. Same two
    // people today, kept separate so that stays a decision.
    function isBoardUser() {
      return signedIn() && userEmail() in
        ['ammar@groovy.op','afnan@groovy.op','daniyal@groovy.op','mustafa@groovy.op','saim@groovy.op'];
    }
    function isBoardOwner() {
      return signedIn() && userEmail() in ['ammar@groovy.op','afnan@groovy.op'];
    }
    // Is the caller the admin of this list? Used by the item update rule so
    // a list admin can edit work they did not create. Guarded on the id
    // being a real string, because an item with listId == null must not
    // build a get() path ending in `null`.
    function tbListAdmin(listId) {
      return listId is string
        && exists(/databases/$(database)/documents/board_lists/$(listId))
        && get(/databases/$(database)/documents/board_lists/$(listId)).data.adminUid == request.auth.uid;
    }
    // Can the caller read the parent item? A comment or an activity row on
    // a private item must be no more readable than the item itself -- the
    // same get()-the-parent rule the mood_boards sub-collections use.
    function tbCanReadItem(itemId) {
      return exists(/databases/$(database)/documents/board_items/$(itemId))
        && ( get(/databases/$(database)/documents/board_items/$(itemId)).data.visibility == 'shared'
             || get(/databases/$(database)/documents/board_items/$(itemId)).data.ownerUid == request.auth.uid );
    }
    // Store Accounts (Sept 2026): Raees enters, owners enter and administer.
    // Mirror in js/store-accounts.js _acctCanEntry().
    function isStoreAccounts() { return isOwner() || (signedIn() && userEmail() == 'raees@groovy.op'); }
    // Store Accounts correction tools (23 Sept 2026; Ammar added 25 Sept):
    // Afnan and Ammar may edit an entry in place, delete one, delete a vendor,
    // reopen a closed month or reset the module. By person, never isOwner().
    // Mirror in js/store-accounts.js _ACCT_SUPER_USERS / _acctIsSuper().
    function isAcctSuper() { return signedIn() && userEmail() in ['afnan@groovy.op','ammar@groovy.op']; }

    // ── Operational data (POs, gate passes, returns, fabric in) ──
    match /pos/{doc}                  { allow read, write: if signedIn(); }
    match /bundles/{doc}              { allow read, write: if signedIn(); }
    match /gatepasses/{doc}           { allow read, write: if signedIn(); }
    match /returns/{doc}              { allow read, write: if signedIn(); }
    // Fabric: any signed-in user may read, add (receipts) and update (QC,
    // issue/return adjust inventory + movements). DELETE is OWNERS + Mustafa
    // by name (Sept 2026 grant) — no other manager, no worker, so no other
    // account, nor a bug running under their credentials, can wipe fabric
    // records. Everyone else still requests deletion via the in-app
    // approval flow, approved by an owner.
    match /fabricin/{doc} {
      allow read:           if signedIn();
      allow create, update: if signedIn();
      allow delete:         if isOwner() || isMustafa();
    }
    match /fabric_inventory/{doc} {
      allow read:           if signedIn();
      allow create, update: if signedIn();
      allow delete:         if isOwner() || isMustafa();
    }
    // Movement ledger = the immutable audit base for Reports/Log. Any signed-in
    // user may APPEND a movement, but no one (not even owners) may edit or
    // delete one — the record can never be altered or removed.
    match /fabric_movements/{doc} {
      allow read:   if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }
    // Drawstrings: lightweight per-color meter balances + their movement log.
    match /fabric_drawstrings/{doc} { allow read, write: if signedIn(); }
    match /drawstring_moves/{doc}   { allow read: if signedIn(); allow create: if signedIn(); allow update, delete: if false; }
    // Edit/delete approval requests for gatepasses/returns/fabricin.
    // Any signed-in user can read (so they can see their own pending state)
    // and create requests; approval/rejection is gated to OM at the app layer.
    match /gatepass_edit_requests/{doc} { allow read, write: if signedIn(); }
    match /activity/{doc}             { allow read, write: if signedIn(); }
    match /counters/{doc}             { allow read, write: if signedIn(); }
    // Custom products added from the New PO form (name + assigned code),
    // merged with the static PRODUCT_CATALOG at runtime. Any signed-in user
    // may read and create; edits/deletes are open (managed at the app layer).
    match /products/{doc}             { allow read, write: if signedIn(); }
    // Daily fulfilment performance (dispatch & returns) — one doc per day.
    match /fulfillment_reports/{doc}  { allow read, write: if signedIn(); }
    // PostEx courier sync — written only by the Netlify function (Admin SDK);
    // clients read-only.
    match /postex_orders/{doc}        { allow read: if signedIn(); allow write: if false; }
    match /postex_sync_meta/{doc}     { allow read: if signedIn(); allow write: if false; }

    // ── PO production flow (reserve → cutting → packing → QC → transfer) ──
    // See PO_PRODUCTION_FLOW_PLAN.md. B-stock (seconds) carton inventory and
    // booked stock-transfer receipts. Any signed-in user reads/writes; the app
    // layer gates who does what (Faizan books transfers, Haris dispositions,
    // managers view B-stock).
    match /bstock_items/{doc}         { allow read, write: if signedIn(); }
    match /bstock_cartons/{doc}       { allow read, write: if signedIn(); }
    match /stock_transfers/{doc}      { allow read, write: if signedIn(); }

    // ── Store ──
    match /store_items/{doc}          { allow read, write: if signedIn(); }
    match /store_transactions/{doc}   { allow read, write: if signedIn(); }
    match /store_notifications/{doc}  { allow read, write: if signedIn(); }
    match /store_categories/{doc}     { allow read, write: if signedIn(); }
    match /store_requests/{doc}       { allow read, write: if signedIn(); }
    match /trim_templates/{doc}       { allow read, write: if signedIn(); }
    // PO issue/edit workflow + shortfall tracking, read by the Store
    // dashboard + PO Issue Requests page. Missing rules here caused 403s
    // on every store dashboard load.
    match /po_issue_requests/{doc}    { allow read, write: if signedIn(); }
    match /po_edit_requests/{doc}     { allow read, write: if signedIn(); }
    match /po_shortfalls/{doc}        { allow read, write: if signedIn(); }

    // ── Store Accounts (Sept 2026 — replaces the Store Cash Ledger) ──
    // Entry is Raees (the store role) + owners; everyone signed in reads.
    // Mirror: js/store-accounts.js _acctCanEntry(). The ledger is APPEND-ONLY:
    // an entry is created, and afterwards only its control fields may change
    // (void / review / confirm / stock posting / the vendor's bill figure) —
    // never its amount, date, vendor or lines. Nothing is ever deleted —
    // except by isAcctSuper() (Afnan, Ammar), whose admin edit rewrites any field
    // and whose admin delete and reset remove documents outright.
    match /acct_entries/{doc} {
      allow read: if signedIn();
      allow create: if isStoreAccounts();
      allow update: if isAcctSuper() || (isStoreAccounts()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','voidedAt','voidedBy','voidReason','needsReview','reviewFlags','reviewedAt','reviewedBy','confirmedAt','confirmedBy','stockPosted','stockError','stockTx','vendorBillAmount']));
      allow delete: if isAcctSuper();
    }
    match /acct_vendors/{doc}     { allow read: if signedIn(); allow create, update: if isStoreAccounts(); allow delete: if isAcctSuper(); }
    match /acct_meter_logs/{doc}  { allow read: if signedIn(); allow write: if isStoreAccounts(); }
    // Owners set everything. Raees may add a CATEGORY from the purchase form
    // and nothing else — the review limits on his own entries stay owner-only.
    // The three fields mirror _ACCT_CAT_FIELDS in js/store-accounts.js.
    match /acct_settings/{doc} {
      allow read: if signedIn();
      allow create: if isOwner() || (isStoreAccounts() && request.resource.data.keys().hasOnly(['categories','updatedAt','updatedBy']));
      allow update: if isOwner() || (isStoreAccounts() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['categories','updatedAt','updatedBy']));
      allow delete: if isOwner();
    }
    match /acct_closes/{doc}      { allow read: if signedIn(); allow create: if isOwner(); allow update: if false; allow delete: if isAcctSuper(); }
    // Legacy Store Cash Ledger — read-only history. Kept so the owner-only
    // one-time import in js/store-accounts.js can read it.
    match /store_cash_ledger/{doc}    { allow read: if signedIn(); allow write: if isOwner(); }
    match /store_cash_accounts/{doc}  { allow read: if signedIn(); allow write: if isOwner(); }
    match /store_cash_floats/{doc}    { allow read: if signedIn(); allow write: if isOwner(); }
    match /store_cash_categories/{doc}{ allow read: if signedIn(); allow write: if isOwner(); }
    match /store_cash_vendors/{doc}   { allow read: if signedIn(); allow write: if isOwner(); }
    match /store_cash_snapshots/{doc} { allow read: if signedIn(); allow write: if isOwner(); }

    // ── Embellishments / printing ──
    match /article_recipes/{doc}      { allow read, write: if signedIn(); }
    match /printing_jobs/{doc}        { allow read, write: if signedIn(); }
    match /qc_reports/{doc}           { allow read, write: if signedIn(); }
    match /printing_billing/{doc}     { allow read, write: if signedIn(); }
    match /sla_events/{doc}           { allow read, write: if signedIn(); }
    match /communication_notes/{doc}  { allow read, write: if signedIn(); }
    match /color_library/{doc}        { allow read, write: if signedIn(); }

    // ── HRM core ──
    // Policies + increment logs are owner+manager territory.
    match /hrm_policies/{doc} {
      allow read:  if isOM();
      allow write: if isOM();
    }
    match /increment_logs/{doc} {
      allow read:  if isOM();
      allow write: if isOwner();   // only owners record increments
    }

    // Employees: any signed-in user can read (workers need to see their
    // own paygrade + balances on their dashboard widget). Write is
    // owner+manager. Payroll mark-paid mutates advanceBalance /
    // loanBalance / updatedAt; this is allowed because _canProcessPayroll
    // is owner-only at the app level, and the rule allows OM writes.
    match /employees/{doc} {
      allow read:  if signedIn();
      allow write: if isOM();
    }

    // ── Payroll ──
    // payroll_runs = running/processing a WHOLE MONTH for every employee —
    // stays owners only (Afnan, Ammar). _canProcessPayroll matches.
    // payslips = individual slips — owners + Mustafa can write (Sept 2026
    // grant, matches _canManagePayslips in js/hrm.js): override a value,
    // mark ONE person's slip paid. Deliberately narrower than payroll_runs
    // so Mustafa's new power doesn't extend to running payroll itself.
    // Note: payslip read is currently open to all signed-in so the worker
    // dashboard "Last month payslip" cue works. Tighten to per-employee
    // self-read once we denormalise auth email onto each payslip.
    match /payroll_runs/{doc} {
      allow read:  if isOM();
      allow write: if isOwner();
    }
    match /payslips/{doc} {
      allow read:  if signedIn();
      allow write: if isOwner() || isMustafa();
    }

    // ── Session 4: Advances / Loans / Policy log / Notifications ──
    // Advances: any OM can view + create requests. Only owners can
    // change status (approve / reject / mark paid) — enforced at the
    // app layer; rules keep write open to OM here so Mustafa can submit.
    match /advance_requests/{doc} {
      allow read:  if isOM();
      allow write: if isOM();
    }
    // Loans have no separate pending→approved step (loanSubmit in js/hrm.js
    // creates one straight into 'active') — so "approve a loan" here means
    // create/pause/resume. Owners + Mustafa (Sept 2026 grant, matches
    // _canManageLoans). Not Arfat, despite also being role='manager'.
    match /loans/{doc} {
      allow read:  if isOM();
      allow write: if isOwner() || isMustafa();
    }
    match /policy_change_log/{doc} {
      allow read:  if isOM();
      allow write: if isOwner();   // only owners log changes
    }
    // Notifications: any signed-in user reads (so workers see their
    // own and dismiss them). Writes any signed-in (notifications are
    // produced by many flows; integrity is enforced by the app).
    match /hrm_notifications/{doc} {
      allow read:  if signedIn();
      allow write: if signedIn();
    }

    // ── Bug Tracker ──
    // Anyone signed in can read (workers see their own bugs filtered
    // client-side; OM sees all). Anyone can create reports; updates
    // (status, assign, comments, upvotes) also open to signed-in users
    // since the actions are gated at the app layer.
    match /bug_reports/{doc} {
      allow read, write: if signedIn();
    }

    // ── Notes / Wiki (Phase 1 of the Notion+Milanote module, Sept 2026) ──
    // 'shared' pages are readable by any signed-in user (team wiki/SOPs).
    // 'personal' pages are readable ONLY by their owner (by uid) — deliberately
    // no isOwner() override here, so a personal note is actually private, not
    // "private except to Afnan/Ammar". Any signed-in user may create a page
    // (personal notes are for everyone, not just OM); only the owner or an
    // app owner may edit/delete one (owners keep cleanup power, matching the
    // fabricin/loans delete pattern elsewhere in this file). Client queries in
    // js/notes.js filter on exactly `visibility` or `ownerUid` so every list
    // query is provably safe under these rules without needing a composite
    // index or a broader query Firestore would reject.
    match /notes_pages/{doc} {
      allow read:   if signedIn() && (resource.data.visibility=='shared' || resource.data.ownerUid==request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid==request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.ownerUid==request.auth.uid || isOwner());
    }

    // ── User profiles (Sept 2026) ──────────────────────────────────────
    // One doc per Firebase uid: photo, chosen display name, job title,
    // department, a short "about". Readable by every signed-in user, which
    // is exactly why NO identity or contact data goes in here — CNIC,
    // address and next-of-kin were asked for and deliberately left out;
    // they belong in `employees`, behind the owner/manager gates above.
    //
    // CREATE is always self, and only self. The document id IS a Firebase
    // uid, and nothing client-side maps a username to one — so an admin
    // literally cannot mint a profile for someone else, and allowing it
    // would only open a way to write a doc at a guessed id. Every account
    // seeds its own row at sign-in (profileBootstrap in js/profile.js).
    //
    // UPDATE is self, plus the Sept 2026 admin grant Afnan asked for:
    // owners and Mustafa may edit other people's profiles, except that
    // Mustafa may NOT edit an owner's. Scoped by name via isOwner() /
    // isMustafa() — never isManager(), because Arfat holds that same role
    // and gets none of this. An admin update may not change `username`,
    // so a profile can't be relabelled as someone else's; the client
    // mirror is _profCanEditUser() in js/profile.js and the password half
    // is netlify/functions/admin-reset-password.js. Change one, change all
    // three.
    //
    // Owners keep delete for moderation, matching the fabricin/loans
    // pattern elsewhere in this file. See js/profile.js.
    match /user_profiles/{uid} {
      allow read:   if signedIn();
      allow create: if signedIn() && uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
                    && request.resource.data.uid == uid
                    && (
                      uid == request.auth.uid
                      || (
                        (isOwner() || isMustafa())
                        && request.resource.data.username == resource.data.get('username','')
                        && !(isMustafa()
                             && resource.data.get('username','') in ['afnan','ammar'])
                      )
                    );
      allow delete: if isOwner();
    }
    // Mood Boards (Phase 2 of the Notion+Milanote module, Sept 2026) — the
    // Milanote half, reached through the same Creative Hub. Same
    // TEAM/PRIVATE pattern as notes_pages above: 'shared' boards readable
    // by any signed-in user, 'personal' boards readable only by their
    // owner, no isOwner() override on read. See js/boards.js.
    //
    // Stage 6 (collaboration) added two things:
    //   1. `sharedWith` — a list of AUTH EMAILS a PRIVATE board is shared
    //      with. Emails, not uids, because rules can read
    //      request.auth.token.email directly and the app has no username→uid
    //      directory to look one up from. Guarded with `in resource.data`
    //      so boards written before this shipped (no such field) still
    //      evaluate instead of erroring.
    //   2. UPDATE on a 'shared' (TEAM) board is now open to any signed-in
    //      user, not just its creator. That is what makes TEAM boards
    //      actually collaborative — live editing, presence and comments
    //      are meaningless if only one person can ever edit. DELETE stays
    //      owner-only so nobody can bin a team board. Mirrored exactly by
    //      _boardsCanEdit() in js/boards.js.
    // Client list queries are three single-field queries (visibility,
    // ownerUid, sharedWith array-contains), one per read clause below, so
    // every query is provably safe without a composite index.
    function boardShared(b)  { return 'sharedWith' in b && userEmail() in b.sharedWith; }
    function canReadBoard(b) { return b.visibility=='shared' || b.ownerUid==request.auth.uid || boardShared(b); }
    match /mood_boards/{doc} {
      allow read:   if signedIn() && canReadBoard(resource.data);
      allow create: if signedIn() && request.resource.data.ownerUid==request.auth.uid;
      allow update: if signedIn() && (resource.data.visibility=='shared'
                                      || resource.data.ownerUid==request.auth.uid
                                      || boardShared(resource.data)
                                      || isOwner());
      allow delete: if signedIn() && (resource.data.ownerUid==request.auth.uid || isOwner());

      // ── Sub-collections (Stage 6) ──
      // Each one checks the PARENT board with a get() rather than a bare
      // signedIn(), so a PRIVATE board's comments, activity and presence
      // are no more readable than the board itself. get() results are
      // cached per rule evaluation, so this is one document read per
      // request, and these collections are all low-volume.
      function parentBoard() {
        return get(/databases/$(database)/documents/mood_boards/$(doc)).data;
      }
      function canSeeParent() { return signedIn() && canReadBoard(parentBoard()); }
      function canEditParent() {
        return signedIn() && (parentBoard().visibility=='shared'
                              || parentBoard().ownerUid==request.auth.uid
                              || boardShared(parentBoard())
                              || isOwner());
      }

      // Who is looking at this board right now. One doc per viewer, keyed
      // by uid and writable only by that viewer; a heartbeat timestamp is
      // what actually decides presence, so a crashed tab that never
      // deletes its row simply goes stale.
      match /presence/{uid} {
        allow read:  if canSeeParent();
        allow write: if canSeeParent() && uid==request.auth.uid;
      }
      // Comments. Anyone who can edit the board may post; the author (or
      // an app owner) may delete; resolve/reopen is open to any editor,
      // since resolving is a shared housekeeping action, not authorship.
      match /comments/{cdoc} {
        allow read:   if canSeeParent();
        allow create: if canEditParent() && request.resource.data.byUid==request.auth.uid;
        allow update: if canEditParent();
        allow delete: if signedIn() && (resource.data.byUid==request.auth.uid || isOwner());
      }
      // The card trash. One document per deleted card, so two people
      // deleting at the same time cannot clobber each other's entry the
      // way a single array on the board document would (the Stage 6 merge
      // is per card). Anyone who can edit the board may delete a card into
      // it and may restore from it; an entry is NEVER edited, only created
      // and purged, so there is no update clause at all. Purging is your
      // own entry, the board's owner clearing up, or an app owner —
      // mirrored by _boardsTrashCanPurge() in js/boards.js.
      match /trash/{tdoc} {
        allow read:   if canSeeParent();
        allow create: if canEditParent() && request.resource.data.byUid==request.auth.uid;
        allow update: if false;
        allow delete: if signedIn() && (resource.data.byUid==request.auth.uid
                                        || parentBoard().ownerUid==request.auth.uid
                                        || isOwner());
      }
      // Per-board activity feed — append-only, like fabric_movements:
      // a record nobody can quietly rewrite, not even an owner.
      match /activity/{adoc} {
        allow read:   if canSeeParent();
        allow create: if canEditParent() && request.resource.data.byUid==request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Shopify Inventory Intelligence ──
    // Sales + catalog data from Shopify. Server-side functions (service
    // account) write these; app users only read. Require auth so data
    // isn't world-readable. Write is denied to client SDKs — only the
    // Admin SDK (Netlify Functions with service account) bypasses rules.
    match /shopify_products/{doc} {
      allow read:  if signedIn();
      allow write: if false;
    }
    match /shopify_orders/{doc} {
      allow read:  if signedIn();
      allow write: if false;
    }
    match /shopify_line_items/{doc} {
      allow read:  if signedIn();
      allow write: if false;
    }
    match /shopify_inventory_snapshots/{doc} {
      allow read:  if signedIn();
      allow write: if false;
    }
    match /shopify_weekly_closes/{doc} {
      allow read:  if signedIn();
      allow write: if false;
    }
    match /shopify_sync_meta/{doc} {
      allow read:  if signedIn();
      allow write: if false;
    }

    // ── The Sales Team ▸ Marketing (Sept 2026) ──
    // Owners + the Creator & Content Operations Lead. Rules cannot read
    // USER_DEFS, so the role is mirrored here by EMAIL — keep this list in
    // lockstep with every role:'creator_content_ops_lead' entry in
    // js/auth.js (canAccessMarketing / isContentOpsLead there).
    function isContentOpsLead() {
      return signedIn() && userEmail() in ['daniyal@groovy.op'];
    }
    function isMarketing() { return isOwner() || isContentOpsLead(); }
    // Paid PR approval — the accounts whose USER_DEFS entry carries
    // canApprovePaidPR:true, by email. The HARD gate: the lead role can
    // request and pay, never decide.
    function isPaidPRApprover() {
      return signedIn() && userEmail() in ['ammar@groovy.op'];
    }
    // Scoring settings — the accounts whose USER_DEFS entry carries
    // canEditScoring:true, by email (Ammar). Everyone in Marketing still
    // READS the bands, since every creator save is scored with them.
    function isScoringAdmin() {
      return signedIn() && userEmail() in ['ammar@groovy.op'];
    }
    function paidPRPath(id) {
      return /databases/$(database)/documents/paid_pr_requests/$(id);
    }
    function creatorHandlePath(h) {
      return /databases/$(database)/documents/creator_handles/$(h);
    }

    // A creator can only be written if the handle lock for its ig_handle
    // points back at it AFTER the write — which is what makes IG-handle
    // uniqueness a server-side guarantee rather than a form check. The
    // client writes the lock and the creator in one transaction.
    match /creators/{id} {
      allow read: if isMarketing();
      allow create, update: if isMarketing()
        && request.resource.data.ig_handle is string
        && request.resource.data.status in ['active','do_not_use','blacklisted']
        && getAfter(creatorHandlePath(request.resource.data.ig_handle)).data.creatorId == id;
      // Owners and the Content Ops lead. The app refuses a creator that any
      // dispatch or Paid PR still names (mktCreatorDeleteBlock).
      allow delete: if isMarketing();
    }
    // One document per handle, naming the creator that owns it. Never
    // updated — an existing lock cannot be taken over — and only removed
    // once its creator no longer carries that handle (a rename) or no
    // longer exists.
    match /creator_handles/{handle} {
      allow read: if isMarketing();
      allow create: if isMarketing()
        && request.resource.data.handle == handle
        && request.resource.data.creatorId is string;
      allow update: if false;
      allow delete: if isMarketing()
        && (!existsAfter(/databases/$(database)/documents/creators/$(resource.data.creatorId))
            || getAfter(/databases/$(database)/documents/creators/$(resource.data.creatorId)).data.ig_handle != handle);
    }
    // Dispatches (M2). A paid_pr dispatch is created only by a Paid PR
    // approval (M3). 'on_hold_stock' (Sept 2026) is a state OUTSIDE the
    // four-stage flow — agreed but not shippable yet. The empty status is for rows migrated from the sheet
    // (M7), which recorded none — left blank rather than guessed; the app
    // shows it as "Not recorded". A dispatch never changes creator or type
    // once written:
    // the creator's rollups are computed per creator, so a moved dispatch
    // would leave two creators wrong.
    match /dispatches/{id} {
      allow read: if isMarketing();
      // Organic: any Marketing account. Paid PR: only the approver, and only
      // as part of approving the request it belongs to — the request must
      // be approved and name this dispatch once the batch lands.
      allow create: if isMarketing()
        && request.resource.data.creator_id is string
        && exists(/databases/$(database)/documents/creators/$(request.resource.data.creator_id))
        && request.resource.data.status in ['','confirmed','in_transit','shipped','content_received','on_hold_stock']
        && (request.resource.data.type == 'organic'
            || (request.resource.data.type == 'paid_pr'
                && isPaidPRApprover()
                && request.resource.data.paid_pr_request_id is string
                && getAfter(paidPRPath(request.resource.data.paid_pr_request_id)).data.status == 'approved'
                && getAfter(paidPRPath(request.resource.data.paid_pr_request_id)).data.dispatch_id == id
                && getAfter(paidPRPath(request.resource.data.paid_pr_request_id)).data.creator_id == request.resource.data.creator_id));
      allow update: if isMarketing()
        && request.resource.data.type == resource.data.type
        && request.resource.data.creator_id == resource.data.creator_id
        && request.resource.data.get('paid_pr_request_id', null) == resource.data.get('paid_pr_request_id', null)
        // The code link is written only by netlify/functions/marketing-discounts.js
        // (Admin SDK); a browser can never attach, detach or fake one.
        && request.resource.data.get('has_discount_code', false) == resource.data.get('has_discount_code', false)
        && request.resource.data.get('discount_code_id', null) == resource.data.get('discount_code_id', null)
        && request.resource.data.get('code_lock_at', null) == resource.data.get('code_lock_at', null)
        && request.resource.data.status in ['','confirmed','in_transit','shipped','content_received','on_hold_stock'];
      // Anyone in Marketing may remove an ORGANIC dispatch logged in error
      // (Sept 2026 — widened from owners-only so the lead can tidy the log).
      // Two shapes can never be deleted by anyone, because another record
      // names them: a paid_pr dispatch, which its approved request links to
      // with dispatch_id, and a dispatch carrying a discount code, which
      // discount_codes/{id} points at and the nightly rollup counts against.
      // Mirrored by mktDispatchDeleteBlock() in js/marketing.js.
      allow delete: if isMarketing()
        && resource.data.type == 'organic'
        && resource.data.get('has_discount_code', false) == false
        && resource.data.get('discount_code_id', null) == null;
    }
    // Paid PR requests (M3). Three kinds of write, each limited to the
    // fields it owns (the lists match MKT_PR_EDIT_FIELDS /
    // MKT_PAYMENT_FIELDS in js/marketing.js — a test holds them equal):
    //   · anyone in Marketing submits one, pending, as themselves, and may
    //     edit its terms while it is still pending;
    //   · ONLY the approver decides it, once, from pending;
    //   · anyone in Marketing logs the payment on an approved one.
    // An approved amount can never change. Nothing is deleted except a
    // still-pending request, by an owner or by whoever raised it — a
    // decided one is the record of a spending decision and the dispatch,
    // the rollups and any discount code are built on it.
    match /paid_pr_requests/{id} {
      allow read: if isMarketing();
      allow create: if isMarketing()
        && request.resource.data.status == 'pending'
        && request.resource.data.requested_by_user_id == request.auth.uid
        && request.resource.data.creator_id is string
        && exists(/databases/$(database)/documents/creators/$(request.resource.data.creator_id))
        && request.resource.data.proposed_amount_pkr is number
        && request.resource.data.proposed_amount_pkr > 0
        && request.resource.data.decided_by_user_id == null
        && request.resource.data.dispatch_id == null;
      allow update: if
        (isMarketing()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.proposed_amount_pkr is number
          && request.resource.data.proposed_amount_pkr > 0
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['deliverable','proposed_amount_pkr','timeline','rationale','updated_at','updated_by_user_id']))
        || (isPaidPRApprover()
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved','rejected']
          && request.resource.data.decided_by_user_id == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status','decided_by_user_id','decided_at','rejection_reason','dispatch_id','updated_at'])
          && ((request.resource.data.status == 'approved'
               && request.resource.data.dispatch_id is string)
              || (request.resource.data.status == 'rejected'
               && request.resource.data.rejection_reason is string
               && request.resource.data.rejection_reason.size() > 0)))
        || (isMarketing()
          && resource.data.status == 'approved'
          && request.resource.data.status == 'approved'
          && request.resource.data.payment_status in ['unpaid','paid']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['payment_status','payment_method','payment_reference','payment_date','payment_logged_by_user_id','payment_logged_at','updated_at']));
      allow delete: if resource.data.status == 'pending'
        && (isOwner()
            || (isMarketing() && resource.data.requested_by_user_id == request.auth.uid));
    }
    // Discount codes (M4). Created and counted ONLY server-side — the Shopify
    // secret lives there, and a redemption count is not something a browser
    // should be able to write. Marketing reads them.
    match /discount_codes/{id} {
      allow read: if isMarketing();
      allow write: if false;
    }
    // Marketing's own settings. Today one document, niche_tags, holding
    // the curated tag list the creator form offers. Anyone in Marketing
    // edits it: it is the Content Ops lead's vocabulary, not a permission
    // boundary, and a tag is only ever a label on a creator record.
    match /marketing_settings/{doc} {
      allow read: if isMarketing();
      allow write: if isMarketing();
    }
    // The scoring bands and tier thresholds — one settings document,
    // edited in the app by the scoring admin only.
    match /scoring_config/{doc} {
      allow read: if isMarketing();
      allow write: if isScoringAdmin();
    }
    // ── Pattern Hub — M0: the article registry (PATTERN_HUB_PLAN.md) ──
    // tac_categories/{PREFIX}: one doc per TAC category, carrying the
    // minting counter (nextNumber). articles/{CODE}: the doc id IS the
    // article code, so uniqueness is the document — a mint is a transaction
    // that reads the article first and refuses if it exists. Readable by
    // anyone signed in (a PO screen will look codes up); written only by the
    // pattern admins. Delete stays owner-only, the fabricin/loans pattern.
    match /tac_categories/{prefix} {
      allow read: if signedIn();
      allow write: if isPatternAdmin();
    }
    match /articles/{code} {
      allow read: if signedIn();
      allow create: if isPatternAdmin()
        && request.resource.data.code == code
        && request.resource.data.category is string
        && request.resource.data.name is string;
      allow update: if isPatternAdmin()
        && request.resource.data.code == resource.data.code
        && request.resource.data.category == resource.data.category;
      allow delete: if isOwner();
    }
    // shopify_articles/{CODE}: the Pattern Hub's per-article liveness rollup
    // (status, sizes seen, product image), written by shopify-catalog-sync.js
    // with the Admin SDK — ~336 docs instead of ~1,500 variants. Clients
    // read only, like every other shopify_* collection.
    match /shopify_articles/{code} {
      allow read: if signedIn();
      allow write: if false;
    }
    // ── Pattern Hub — M2: blocks and the hook rack ──
    // patterns/{id}: one physical block (all sizes bundled). The article→
    // block link lives on articles/{code}.patternId, never here. Code and
    // creation fields are immutable once written.
    match /patterns/{id} {
      allow read: if signedIn();
      allow create: if isPatternAdmin()
        && request.resource.data.code is string
        && request.resource.data.name is string
        && request.resource.data.category is string;
      allow update: if isPatternAdmin()
        && request.resource.data.code == resource.data.code
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner();

      // A revision is the record of a physical correction. APPEND-ONLY,
      // like fabric_movements and the board activity feed — the history
      // cutting acted on must not be editable after the fact.
      match /revisions/{n} {
        allow read: if signedIn();
        allow create: if isPatternAdmin();
        allow update, delete: if false;
      }
    }
    // pattern_notices/{id}: what cutting has to update, raised with the
    // revision. Only the four acknowledge fields may ever change, and only
    // cutting or an admin may change them — the Marketing M3 shape. The
    // JS list _PTN_ACK_FIELDS is asserted equal to this hasOnly list.
    match /pattern_notices/{id} {
      allow read: if signedIn();
      allow create: if isPatternAdmin();
      allow update: if (isPatternAdmin() || isPatternCutting())
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','ackBy','ackAt','ackNote'])
        && request.resource.data.status == 'acknowledged';
      allow delete: if false;
    }
    // pattern_slots/{H-S}: the lock that makes a rack slot exclusive —
    // written in the same transaction as the block's hook/slot, so two
    // blocks can never share one. Exactly 50 possible ids.
    match /pattern_slots/{key} {
      allow read: if signedIn();
      allow write: if isPatternAdmin()
        && key.matches('^([1-9]|10)-[1-5]$');
    }
    // pom_templates/{id}: the points of measure a block's grid is built
    // from (top · pant · short · jacket), editable in-app. Deleting a point
    // here never touches a block's recorded numbers — those live on
    // patterns/{id}.grid and are cleared there, on purpose.
    match /pom_templates/{id} {
      allow read: if signedIn();
      allow write: if isPatternAdmin();
    }
    // settings/{doc}: small app-level switches. Today only
    // settings/pattern_hub.poIntegration — whether a PO carries its
    // pattern code and hook. Everyone reads it (a PO page asks); an OWNER
    // alone flips it, since it changes what every PO prints.
    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // ══ The Board (Sept 2026) ═══════════════════════════════════════════
    // One object: an item. An item with a date is on the calendar, an item
    // in a list is a to-do, an item can be both. See BOARD.md.
    //
    // NOTE FOR THE CLIENT, because rules are not a query filter: every read
    // rule below is a TWO-CLAUSE condition, so a single broad query whose
    // safety depends on a field outside its where() is REJECTED outright
    // rather than silently returning less. Each clause therefore gets its
    // own single-field query, merged client-side -- exactly what
    // loadNotesData() and loadBoardsData() already do.

    // board_config/{doc}: the launch markers the calendar draws. Read by
    // every Board user, written by a Board owner.
    match /board_config/{doc} {
      allow read:  if isBoardUser();
      allow write: if isBoardOwner();
    }

    // board_lists/{id}: a shared list has an admin and members; a private
    // list has only its admin. Query as: kind=='shared' + memberUids
    // array-contains uid, OR adminUid == uid.
    match /board_lists/{id} {
      allow read: if isBoardUser()
        && ( (resource.data.kind == 'shared' && request.auth.uid in resource.data.memberUids)
             || request.auth.uid == resource.data.adminUid );
      allow create: if isBoardUser()
        && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if isBoardUser()
        && (request.auth.uid == resource.data.adminUid || isBoardOwner());
    }

    // board_items/{id}: the whole product. Query as: visibility=='shared',
    // OR ownerUid == uid.
    match /board_items/{id} {
      allow read: if isBoardUser()
        && (resource.data.visibility == 'shared' || request.auth.uid == resource.data.ownerUid);

      // The creator owns it and is on it. Both halves matter: an item
      // nobody is assigned to would never appear on any calendar.
      allow create: if isBoardUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.assigneeUids;

      // THE LOCK IS THE POINT OF THE WHOLE PRODUCT, and it is enforced
      // here rather than in the UI: on a locked item only the locker (or a
      // Board owner) may change `date` or `dueAt`. Everything else --
      // comments, steps, notes, files, status, assignees -- stays open to
      // the people doing the work. Locked is not frozen; it means one
      // person moves the date.
      //
      // The third clause stops a member from re-pointing `lockedBy` at
      // themselves and walking through the second.
      allow update: if isBoardUser()
        && ( request.auth.uid in resource.data.assigneeUids
             || request.auth.uid == resource.data.ownerUid
             || tbListAdmin(resource.data.get('listId', null))
             || isBoardOwner() )
        && ( resource.data.get('locked', false) != true
             || request.auth.uid == resource.data.get('lockedBy', '')
             || isBoardOwner()
             || ( request.resource.data.get('date', null) == resource.data.get('date', null)
                  && request.resource.data.get('dueAt', null) == resource.data.get('dueAt', null) ) )
        && ( request.resource.data.get('lockedBy', null) == resource.data.get('lockedBy', null)
             || request.auth.uid == request.resource.data.get('lockedBy', '')
             || isBoardOwner() );

      allow delete: if isBoardUser()
        && (request.auth.uid == resource.data.ownerUid || isBoardOwner())
        && ( resource.data.get('locked', false) != true
             || request.auth.uid == resource.data.get('lockedBy', '')
             || isBoardOwner() );

      // Comments: readable exactly as far as the item is. Editing and
      // deleting are your own only; a Board owner may delete one for
      // moderation, matching the fabricin/loans pattern elsewhere here.
      match /comments/{c} {
        allow read:   if isBoardUser() && tbCanReadItem(id);
        allow create: if isBoardUser() && request.resource.data.authorUid == request.auth.uid;
        allow update: if isBoardUser() && resource.data.authorUid == request.auth.uid;
        allow delete: if isBoardUser() && (resource.data.authorUid == request.auth.uid || isBoardOwner());
      }

      // Activity is APPEND-ONLY -- the same principle as fabric_movements
      // and the mood-board activity feed. A log that can be edited is not
      // a log, and "ammar overrode a lock" has to survive whoever it
      // inconveniences.
      match /activity/{a} {
        allow read:   if isBoardUser() && tbCanReadItem(id);
        allow create: if isBoardUser() && request.resource.data.byUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
    // NOTE: The Board writes its notifications into hrm_notifications
    // (already `signedIn()` above) rather than a collection of its own, so
    // it inherits the existing bell and unread badge. There is deliberately
    // no board_notifications match block -- see _tbNotify in
    // js/theboard.js.
  }
}
